# Handle text files automatically and normalize to LF in the repo
* text=auto

# Explicitly declare files that must always use LF (e.g., shell scripts)
*.sh text eol=lf

# Explicitly declare files that must always use CRLF (e.g., Windows batch files)
*.bat text eol=crlf

# Denote binary files so Git leaves them completely untouched
*.png binary
*.jpg binary
