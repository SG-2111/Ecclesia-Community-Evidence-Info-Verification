# Auto-detect text files and normalize to LF in the repository
* text=auto eol=lf

# Explicitly declare text files that should always use LF
*.java    text eol=lf
*.xml     text eol=lf
*.properties text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files — never touch these
*.jar     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.class   binary
*.ser     binary
